# ── Backend environment variables ──
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Server
NODE_ENV=development
PORT=5000

# Database (MongoDB Atlas connection string or local instance)
MONGO_URI=your_mongodb_connection_string

# Auth
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=2h
# Dedicated CSRF Secret (must be at least 32 characters and distinct from JWT_SECRET in production)
CSRF_SECRET=your_independent_csrf_secret_32chars_minimum
# Dedicated Fix Day Proposal Secret (must be at least 32 characters and distinct from JWT_SECRET and CSRF_SECRET in production)
# Used for HMAC-SHA256 signing of Fix Day candidate itinerary proposals
FIX_DAY_PROPOSAL_SECRET=your_independent_fix_day_proposal_secret_32chars_minimum

# Admin account (used for the admin gateway)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# AI provider (Google Gemini API / Google AI Studio)
# Primary model is gemini-3.5-flash-lite; automatic fallback to gemini-3.1-flash-lite is handled in code
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_MS=60000

# CORS — comma-separated list of allowed frontend origins.
# The FIRST origin is also used as the base URL for password-reset / verification email links.
CLIENT_URL=http://localhost:5173

# ── Email (EmailJS, OPTIONAL) ──
# Used for server-side password-reset and email-verification messages.
# If left blank, those emails are skipped gracefully (the app still runs).
# Create two templates in the EmailJS dashboard that use these params:
#   {{to_email}}  {{user_name}}  {{link}}  {{subject}}
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_RESET_TEMPLATE_ID=
EMAILJS_VERIFY_TEMPLATE_ID=

# ── Cloudinary Media Storage (OPTIONAL / PRODUCTION) ──
# If configured, cover image uploads are streamed directly to Cloudinary.
# If omitted in dev/test, image uploads safely use in-memory simulated storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ── Google Identity Services (GIS) / Google Sign-In (OPTIONAL) ──
# Feature flag to enable Google Sign-In. Defaults to false.
# When enabled in production, GOOGLE_CLIENT_ID is mandatory.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
